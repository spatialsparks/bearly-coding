# Stack-specific — delete the sections that do not apply
# ---------------------------------------------------------------------------

# Node
node_modules/
.pnpm-store/
.next/
.turbo/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

